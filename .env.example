# LLM 配置（支持自定义 base_url，如美团 FRIDAY API）
LLM_MODEL=glm-5.2
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://aigc.sankuai.com/v1/openai/native
LLM_TEMPERATURE=0.1
LLM_STREAMING=false

# Embedding 配置（支持本地 Ollama）
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=ollama
EMBEDDING_BASE_URL=http://localhost:11434/v1

# 模型缓存目录（BGE reranker 等）
MODEL_CACHE_DIR=./models

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=knowledge_base

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# RAG 配置
DOC_CHUNK_MAX_SIZE=800
DOC_CHUNK_OVERLAP=100
RAG_TOP_K=3

# 外部工具
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# 应用配置
APP_PORT=9900
UPLOAD_DIR=./uploads
DEBUG=false
# 持久化目录（skills 落盘 / MCP 注册表）
SAVE_DIR=./saves

# 持久化数据库（SQLAlchemy 2.0 async）。SQLite 起步、PostgreSQL 就绪：
# 切 PG 只改这一行，如 postgresql+asyncpg://user:pwd@localhost:5432/data_agent
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# 知识库工具（需要 Milvus；未部署时保持 false，chat 不依赖 Milvus）
ENABLE_KB_TOOL=false

# 演示数据源（Kaggle Brazilian E-Commerce 导入的 SQLite）
SQLITE_DB_PATH=./data/ecommerce.db

# API Key 鉴权 + 工作空间隔离（F 轮，详见 app/core/IMPLEMENTATION-auth.md）
# false = demo 模式（默认）：占位 dev_user、读写全开，行为与鉴权落地前完全一致。
# true  = 启用鉴权：写操作需带 Bearer API Key（Authorization: Bearer da-xxxx），
#         MCP 全部写口与技能启停需 admin；读接口保持开放。
#         首启无用户时自动创建 default 工作空间 + admin 用户，明文 Key 打进 warning
#         日志一次（形如：新建 admin API Key: da-xxxxxxxx...，请立即保存），此后不再明文出现。
AUTH_ENABLED=false

# 技能脚本执行沙箱（详见 app/skills/IMPLEMENTATION-sandbox.md）
# subprocess = 本地进程直跑（默认，零额外依赖，无 Docker 也能用）
# docker     = 每次执行拉起一次性容器（--network none 断网 + 只读根文件系统 + 资源限额），
#              需本机安装 Docker 并提前拉好镜像：docker pull python:3.11-slim
# 注意：docker 模式下脚本只能读到技能目录本身（只读挂载为 /skill），
#       需要读宿主机其它路径（如 SQLITE_DB_PATH）的脚本请把数据放进技能目录
SKILL_SANDBOX_MODE=subprocess
SKILL_SANDBOX_IMAGE=python:3.11-slim
SKILL_SANDBOX_MEMORY=256m
SKILL_SANDBOX_CPUS=0.5

# Langfuse 调用链追踪（可选，默认关闭）
# 需同时把 LANGFUSE_ENABLED 设为 true 且填好 public/secret key 才会启用；
# 缺 key 时自动跳过，聊天主流程完全不受影响。凭证在 Langfuse 项目设置里获取。
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 云端用 https://cloud.langfuse.com；自建实例填你自己的地址
LANGFUSE_HOST=https://cloud.langfuse.com
