# LLM 配置（支持自定义 base_url，如美团 FRIDAY API）
LLM_MODEL=glm-5.2
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://aigc.sankuai.com/v1/openai/native
LLM_TEMPERATURE=0.1
LLM_STREAMING=false

# Embedding 配置（支持本地 Ollama）
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=ollama
EMBEDDING_BASE_URL=http://localhost:11434/v1

# 模型缓存目录（BGE reranker 等）
MODEL_CACHE_DIR=./models

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=knowledge_base

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# RAG 配置
DOC_CHUNK_MAX_SIZE=800
DOC_CHUNK_OVERLAP=100
RAG_TOP_K=3

# 外部工具
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# 应用配置
APP_PORT=9900
UPLOAD_DIR=./uploads
DEBUG=false
# 持久化目录（skills 落盘 / MCP 注册表）
SAVE_DIR=./saves

# 知识库工具（需要 Milvus；未部署时保持 false，chat 不依赖 Milvus）
ENABLE_KB_TOOL=false

# 演示数据源（Kaggle Brazilian E-Commerce 导入的 SQLite）
SQLITE_DB_PATH=./data/ecommerce.db

# Langfuse 调用链追踪（可选，默认关闭）
# 需同时把 LANGFUSE_ENABLED 设为 true 且填好 public/secret key 才会启用；
# 缺 key 时自动跳过，聊天主流程完全不受影响。凭证在 Langfuse 项目设置里获取。
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 云端用 https://cloud.langfuse.com；自建实例填你自己的地址
LANGFUSE_HOST=https://cloud.langfuse.com
